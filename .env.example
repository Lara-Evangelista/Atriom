# Atriom Monorepo - Environment Template
# Do not put actual secrets in this file. Copy this or the subfolder .env.example
# files to .env in each corresponding subfolder:
#   - chore-app-frontend/.env
#   - chore-app-mobile/.env
#   - chore-app-backend/.env (optional, used for Supabase CLI / edge functions)

# ==============================================================================
# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# ==============================================================================
# Web frontend:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# VITE_CALENDAR_FEED_URL=https://your-project.supabase.co/functions/v1/calendar-feed
# VITE_VAPID_PUBLIC_KEY=your-webpush-public-key

# Mobile app (React Native / Expo):
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# EXPO_PUBLIC_EAS_PROJECT_ID=your-expo-eas-project-id
