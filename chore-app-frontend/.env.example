# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The PUBLISHABLE key (starts with sb_publishable_...), NOT the secret key.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of your deployed calendar-feed edge function, used to build the
# "subscribe by URL" link shown in Settings, e.g.:
# https://YOUR-PROJECT.supabase.co/functions/v1/calendar-feed
VITE_CALENDAR_FEED_URL=https://YOUR-PROJECT.supabase.co/functions/v1/calendar-feed

# The PUBLIC half of the VAPID keypair used for Web Push (see backend
# README "Web Push" section for how to generate it). Only the public key
# ever belongs here — never put the private key in frontend code.
VITE_VAPID_PUBLIC_KEY=
