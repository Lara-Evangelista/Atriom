{
  "expo": {
    "name": "Atriom",
    "slug": "atriom",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/55fbea0b-994f-4b85-bac7-4a402de31f0c",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chores",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.laraevangelista.atriom",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.laraevangelista.atriom",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E7623E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E7623E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayChores",
              "label": "Today's Chores",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "description": "See today's chores and mark them done or delay them.",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "OutOfStock",
              "label": "Out of Stock",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "description": "See what's flagged as out of stock and mark items as restocked.",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55fbea0b-994f-4b85-bac7-4a402de31f0c"
      }
    }
  }
}
